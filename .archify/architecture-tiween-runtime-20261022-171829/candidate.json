  "cards": [
    { "dot": "amber", "title": "Primary path: short-film directory (v1)", "items": [
      "Backend is live: GET /api/creative-works/creative-works/short-films[/featured|/:slug|/:slug/related], auth: false, 600 req/min rate limit, published rows only, French fallback overlay.",
      "Frontend is not wired yet: /shorts and /shorts/[slug] render mock files. Wiring them to Strapi is the 'Strapi-Backed Shorts Pages' phase (dashed edge).",
      "The client shorts module still calls /creative-works with phantom populate keys, so the live /api/shorts handler would not reach the plugin route today."
    ] },
    { "dot": "rose", "title": "Trust boundaries", "items": [
      "Strapi API tokens (read-only + custom) and the user JWT are attached only on the Next.js server; browsers reach Strapi through /api/public-proxy or /api/private-proxy.",
      "The private proxy forwards only allow-listed method + path prefixes; tenant scope (venue manager, watchlist owner) is resolved from the JWT inside Strapi.",
      "Algolia is the one external the browser calls directly, with a search-only key."
    ] },
    { "dot": "emerald", "title": "Backend composition", "items": [
      "One Strapi process hosting local plugins: geography → venues → creative-works → tmdb-integration → events-manager → ticketing / payments → user-engagement; users-permissions loads after them.",
      "Plugins depend on each other by content-type UID and public-api services (ticketing calls payments.public-api.initPayment only).",
      "entity-properties is a deprecated empty shell; the api/ folder holds only a health check."
    ] },
    { "dot": "violet", "title": "Media and email", "items": [
      "Media goes to ImageKit when IMAGEKIT_* is set, otherwise local uploads; the upload plugin flag is currently false in config.",
      "Transactional email goes through the in-repo Brevo provider (packages/strapi-provider-email-brevo) and logs to the console without an API key."
    ] },
    { "dot": "cyan", "title": "Planned (not in code yet)", "items": [
      "Self-hosted Meilisearch next to Strapi on the Dokploy VPS, synced on publish; Algolia removed.",
      "No Redis: rate limiting and caching are in-process, so Strapi runs as a single replica."
    ] },
    { "dot": "slate", "title": "Deployment", "items": [
      "docker-compose.prod.yml runs client (:3000), strapi (:1337) and postgres on one network; GitHub Actions triggers Dokploy deploys."
    ] }
  ]
}
