{
  "collectionName": "components_common_videos",
  "info": {
    "displayName": "Video",
    "icon": "file-video",
    "description": "Video link. Use videoType — it is what every consumer reads. The older type field (FULL_LENGTH/TEASER/CLIP) is kept for historic rows only; leave it as it is."
  },
  "options": {},
  "attributes": {
    "url": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "FULL_LENGTH",
        "TEASER",
        "CLIP"
      ],
      "default": "TEASER",
      "required": false
    },
    "videoType": {
      "type": "enumeration",
      "enum": [
        "trailer",
        "teaser",
        "clip",
        "featurette",
        "interview",
        "behind-the-scenes",
        "full-length"
      ],
      "required": false
    }
  }
}
