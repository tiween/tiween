{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Occurrence datee et localisee (conteneur / superEvent)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "movie_screening",
        "theater_performance",
        "concert",
        "exhibition",
        "other"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "startDateTime": {
      "type": "datetime",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "endDateTime": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "eventStatus": {
      "type": "enumeration",
      "enum": [
        "scheduled",
        "cancelled",
        "postponed",
        "rescheduled"
      ],
      "default": "scheduled",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "externalId": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "venue": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::venues.venue",
      "inversedBy": "events",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "screenings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::events-manager.screening",
      "mappedBy": "event",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "performances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::events-manager.performance",
      "mappedBy": "event",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "eventGroup": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::events-manager.event-group",
      "inversedBy": "events",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
