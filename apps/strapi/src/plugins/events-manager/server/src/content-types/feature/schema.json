{
  "kind": "collectionType",
  "collectionName": "features",
  "info": {
    "singularName": "feature",
    "pluralName": "features",
    "displayName": "Feature",
    "description": "Vocabulaire controle : caracteristiques d'une seance (premiere, equipe presente, VOSTFR...)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "technical",
        "event",
        "accessibility"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "screenings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::events-manager.screening",
      "mappedBy": "features",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "performances": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::events-manager.performance",
      "mappedBy": "features",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
