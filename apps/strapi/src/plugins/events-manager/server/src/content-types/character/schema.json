        }
      }
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "credits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::events-manager.credit",
