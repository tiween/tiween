{
  "kind": "collectionType",
  "collectionName": "movies",
  "info": {
    "singularName": "movie",
    "pluralName": "movies",
    "displayName": "Movie",
    "description": "Oeuvre cinema (schema.org Movie) - cache TMDB optionnel ou saisie maison"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "originalTitle": {
      "type": "string"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "feature",
        "short",
        "medium"
      ],
      "default": "feature",
      "required": true
    },
    "tmdbId": {
      "type": "string",
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "overview": {
      "type": "text"
    },
    "runtime": {
      "type": "integer"
    },
    "releaseDate": {
      "type": "date"
    },
    "director": {
      "type": "string"
    },
    "originalLanguage": {
      "type": "string"
    },
    "payload": {
      "type": "json"
    },
    "fetchedAt": {
      "type": "datetime"
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "posterPath": {
      "type": "string"
    },
    "screenings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::events-manager.screening",
      "mappedBy": "movie"
    },
    "credits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::events-manager.credit",
      "mappedBy": "movie"
    }
  }
}
