{
  "kind": "collectionType",
  "collectionName": "venues",
  "info": {
    "singularName": "venue",
    "pluralName": "venues",
    "displayName": "Venue",
    "description": "Lieu (schema.org MovieTheater / PerformingArtsTheater / Place)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "address": {
      "type": "text"
    },
    "cityRef": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::geography.city"
    },
    "geo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.geo-point"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "website": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": ["cinema", "theater", "cultural-center", "museum", "other"]
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "approved", "suspended"],
      "default": "pending"
    },
    "capacity": {
      "type": "integer"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "manager": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "properties": {
      "type": "component",
      "repeatable": true,
      "component": "entity-properties.property-value"
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::events-manager.event",
      "mappedBy": "venue"
    }
  }
}
