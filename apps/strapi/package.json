{
  "name": "@tiween/admin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "types": "./types",
  "scripts": {
    "build": "strapi build",
    "config:dump": "strapi configuration:dump -f dump.json",
    "config:restore": "strapi configuration:restore -f dump.json",
    "crawl:plays": "tsx scripts/crawlers/tunisian-plays/cli.ts crawl",
    "crawl:plays:sources": "tsx scripts/crawlers/tunisian-plays/cli.ts sources",
    "crawl:plays:validate": "tsx scripts/crawlers/tunisian-plays/cli.ts validate",
    "dev": "yarn run:db && yarn develop",
    "develop": "portless api.tiween strapi develop",
    "develop:watch": "strapi develop --watch-admin",
    "export:all": "strapi export --file strapi-export --no-encrypt",
    "export:content": "strapi export --only content --no-encrypt --file strapi-export",
    "generate": "strapi generate",
    "generate:types": "strapi ts:generate-types",
    "import": "strapi import -f strapi-export.tar.gz",
    "run:db": "docker compose up -d db",
    "seed": "tsx scripts/seeds/index.ts",
    "seed:clear": "tsx scripts/seeds/clear.ts",
    "seed:fresh": "yarn seed:clear && yarn seed",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "transfer": "strapi transfer"
  },
  "dependencies": {
    "@ayhid/strapi-provider-email-brevo": "^0.0.0-development",
    "@strapi/plugin-documentation": "^5.33.1",
    "@strapi/plugin-sentry": "^5.33.1",
    "@strapi/plugin-users-permissions": "^5.33.1",
    "@strapi/provider-email-mailgun": "^5.33.1",
    "@strapi/provider-upload-aws-s3": "^5.33.1",
    "@strapi/strapi": "^5.33.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "fastest-levenshtein": "^1.0.16",
    "imagekit": "^5.2.0",
    "lodash": "^4.17.21",
    "pg": "^8.13.1",
    "qs": "^6.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "rrule": "^2.8.1",
    "strapi-plugin-config-sync": "2.1.0",
    "strapi-plugin-imagekit": "^1.0.2",
    "strapi-provider-upload-imagekit": "^5.11.11",
    "styled-components": "^6.0.0",
    "tmdb-ts": "^2.0.0",
    "use-debounce": "^10.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^6",
    "better-sqlite3": "^12.10.0",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "jsdom": "^25",
    "supertest": "^7",
    "ts-jest": "^29",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22"
  },
  "strapi": {
    "uuid": "@tiween/admin"
  }
}
