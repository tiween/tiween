# Tweak for your needs and rename to .env
# Do not leave empty values, e.g. `DATABASE_PASSWORD=`, as it is interpreted as an empty string and
# default values won't be used. If you want to fallback to default values, remove or comment the line completely.

# ----- Strapi general -----

# The host where Strapi will listen.
HOST=0.0.0.0

# The port where Strapi will listen.
PORT=1337

# The secret keys used to sign the session cookies.
APP_KEYS=l8ftzyp2hNmEtNXBYU5hhQ==,lH7EcVVZxIoTFRorjrV9Vw==,jxWii7EjavRgJ4jYPZ60hA==,FlZM4tyij/HDFcKZhsmlXQ==

# The secret used to sign the API tokens.
API_TOKEN_SALT=usReW/cYjLHmpLEoRnWf+g==

# The secret used to sign the JWT for the Admin panel.
ADMIN_JWT_SECRET=Xw39b/xXxEHW1x1WMM6ugQ==

# The secret used to sign the JWT for the Users-Permissions plugin
JWT_SECRET=ShuOcfjTi/RwcchWEIKYKA==

# The secret used to sign the token for transfer data between 2 Strapi instances.
# TRANSFER_TOKEN_SALT=

# Enable or disable cron jobs. Default: false
# CRON_ENABLED=

# Sets the public URL of the application (usually related to production deploy).
# Local dev uses Portless: https://api.tiween.localhost:1355
APP_URL=https://api.tiween.localhost:1355

# The URL of the admin panel. Consumed by frontend of custom strapi plugin.
# STRAPI_ADMIN_BACKEND_URL=http://localhost:1337

# Enable or disable receiving populated relations in webhooks. Default: false
# WEBHOOKS_POPULATE_RELATIONS=

# ----- Database -------

# Full connection string for the database. It has higher priority than the other database connection options.
# DATABASE_URL=

# The database client to use.
DATABASE_CLIENT=postgres

# The database host.
DATABASE_HOST=0.0.0.0

# The database port.
DATABASE_PORT=5437

# The database name.
DATABASE_NAME=tiween

# The database username.
DATABASE_USERNAME=admin

# The database password.
DATABASE_PASSWORD=mFm8z7z8

# Enable SSL support.
DATABASE_SSL=false

# Test database name. Default: .tmp/test.db
# TEST_DATABASE_FILENAME=

# ------- Dev admin seed -------

# On a fresh DB, bootstrap seeds a super-admin so you can log in without the
# admin first-run screen. No-op if any admin already exists. Default-on in dev;
# in production it only runs when SEED_ADMIN=true AND SEED_ADMIN_PASSWORD is set.
# SEED_ADMIN=false
# SEED_ADMIN_EMAIL=admin@test.com
# SEED_ADMIN_PASSWORD=Test123!
# SEED_ADMIN_FIRSTNAME=Admin
# SEED_ADMIN_LASTNAME=User

# ------- Brevo (Email) -------

# Brevo API key (get from https://app.brevo.com/settings/keys/api)
# Required for production, optional in development (falls back to console logging)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default sender email (must be verified in Brevo)
BREVO_SENDER_EMAIL=noreply@tiween.tn

# Default sender name
BREVO_SENDER_NAME=Tiween

# ------- Sentry -------

# SENTRY_DSN=

# ------- ImageKit -------

# ImageKit public key (starts with public_)
# IMAGEKIT_PUBLIC_KEY=public_xxxxx

# ImageKit private key (starts with private_)
# IMAGEKIT_PRIVATE_KEY=private_xxxxx

# ImageKit URL endpoint (e.g., https://ik.imagekit.io/your_id)
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ImageKit folder for uploads (optional, default: tiween)
IMAGEKIT_FOLDER=tiween

# ------- Social login (OAuth grant store) -------

# The OAuth handshake for Google/Facebook runs in the Next.js client app
# (NextAuth), so the FUNCTIONAL credentials live there (apps/client GOOGLE_* /
# FACEBOOK_*). Strapi only needs the providers ENABLED in its users-permissions
# grant store, which the `ensureSocialProviders` bootstrap seeds idempotently.
# The vars below are OPTIONAL — set them only if you also drive Strapi's own
# /connect/:provider grant flow directly; they are merged into the grant store
# entry (key/secret/callback) when present.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=

# ------- OTHER -------

# Link to the frontend account activation page. It is used in email templates sent by backend.
# CLIENT_ACCOUNT_ACTIVATION_URL=https://tiween.localhost:1355/auth/activate

# Link to the frontend password-reset page. Used to build the reset link in the
# password-reset email as `${CLIENT_RESET_PASSWORD_URL}?code=<token>&email=<email>`.
# When unset, the reset email is skipped (a warning is logged).
# CLIENT_RESET_PASSWORD_URL=https://tiween.localhost:1355/auth/reset-password

# Reset-token time-to-live, in milliseconds. Honored only when it parses to a
# finite number > 0; otherwise the 1h default (3600000) is used.
# RESET_TOKEN_TTL_MS=3600000

# ------- Strapi Preview Feature --------

# Base URL of the frontend. Can be used by backend to generate links to frontend.
# Required for Strapi Preview
# Local dev uses Portless: https://tiween.localhost:1355
CLIENT_URL=https://tiween.localhost:1355
# Strapi Preview toggle. Values "true" => enabled, else disabled
STRAPI_PREVIEW_ENABLED=true
# Shared secret for frontend and backend that enables draft mode
STRAPI_PREVIEW_SECRET=your-secret-key
