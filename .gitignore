# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
out/
build

# other
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# turbo
.turbo

#jetbrains IDEs
.idea

.cache

.strapi-updater.json

# backup files
*.bak


# Local Netlify folder
.netlify

# Claude Code session files
.call_count
.circuit_breaker_*
.exit_signals
.last_reset
.ralph_session
.ralph_session_history
.response_analysis

# Logs and temp status
logs/
progress.json
status.json

# Nested repositories
RALPH_PRD/

# Playwright MCP browser artifacts (scratch)
.playwright-mcp/

# CodeGraph index (generated)
.codegraph/

# Python bytecode caches
__pycache__/
*.pyc

# Track the repo .envrc (pins PORTLESS_PORT for dev) even when a user's
# global gitignore excludes .envrc files.
!.envrc

# Claude Code per-machine settings (absolute paths, personal permissions)
.claude/settings.local.json

# GSD runtime: regenerated by the GSD installer on each machine. Vendored libs
# hold raw control bytes the repo-hygiene guard rejects, and prettier would
# rewrite installer-managed files.
.claude/gsd-core/
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/scripts/
.claude/gsd-migration-journal/
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/.gsd-profile
.codex/
